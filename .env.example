# --- Aplicación ---------------------------------------------------------------
# development: permite http y muestra la app sin forzar HTTPS.
# production : fuerza HTTPS, cookies Secure y cabecera HSTS.
APP_ENV=development

# URL pública (sin barra final). Se usa para el QR y las redirecciones.
# En producción debe ser https://, p. ej. https://cafe.pierooof.dev
APP_URL=http://localhost:8000

# Zona horaria para "sellos de hoy" y "canjes del mes".
APP_TIMEZONE=Europe/Madrid

# Puerto en el que escucha la app (Railway lo inyecta solo).
PORT=8000

# --- Proxies ------------------------------------------------------------------
# Nº de proxies de confianza delante de la app (Railway = 1; con Cloudflare
# delante de Railway suelen ser 2). 0 = ignorar X-Forwarded-*.
# Si llega CF-Connecting-IP se usa como IP real del cliente.
TRUSTED_PROXIES=1

# --- Base de datos MySQL 8 ----------------------------------------------------
# Opción A (Railway): una sola URL.
MYSQL_URL=mysql://root:root@127.0.0.1:3306/cafepunto
# Opción B: variables sueltas (se usan si MYSQL_URL está vacía).
# MYSQLHOST=127.0.0.1
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=root
# MYSQLDATABASE=cafepunto

# --- Datos de demostración ----------------------------------------------------
# true: al arrancar se crean el barista/cliente demo y clientes de ejemplo.
SEED_DEMO=true
# true: la pantalla de login muestra las credenciales demo.
DEMO_HINT=true
